<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="DataSphere.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:utils="using:DataSphere.Utils">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <utils:TranslationSource x:Key="Localization" />
            <helpers:InverseBooleanConverter x:Key="InverseBooleanConverter" xmlns:helpers="using:DataSphere.Helpers" />
            <helpers:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" xmlns:helpers="using:DataSphere.Helpers" />
            <helpers:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" xmlns:helpers="using:DataSphere.Helpers" />
            <helpers:NullToVisibilityConverter x:Key="NullToVisibilityConverter" xmlns:helpers="using:DataSphere.Helpers" />
            <helpers:NotNullToVisibilityConverter x:Key="NotNullToVisibilityConverter" xmlns:helpers="using:DataSphere.Helpers" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
