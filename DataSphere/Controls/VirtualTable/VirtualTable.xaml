<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="DataSphere.Controls.VirtualTable.VirtualTable"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
    IsTabStop="True">

    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Column Header Layer -->
        <Border
            x:Name="HeaderBorder"
            Grid.Row="0"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <Canvas x:Name="HeaderCanvas" Height="36" />
        </Border>

        <!-- Table Viewport ScrollViewer Layer -->
        <ScrollViewer
            x:Name="TableScrollViewer"
            Grid.Row="1"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollMode="Enabled"
            VerticalScrollMode="Enabled"
            ZoomMode="Disabled">
            <Canvas x:Name="VirtualScrollHost" Background="Transparent">
                <Canvas x:Name="VirtualCanvas" />
                <Canvas x:Name="EditorCanvas" IsHitTestVisible="True">
                    <TextBox
                        x:Name="CellEditorOverlay"
                        Visibility="Collapsed"
                        FontSize="13"
                        Padding="8,4"
                        VerticalAlignment="Center"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" />
                </Canvas>
            </Canvas>
        </ScrollViewer>
    </Grid>
</UserControl>
