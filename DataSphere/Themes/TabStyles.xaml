<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <Thickness x:Key="TabViewItemHeaderPadding">0,0,0,0</Thickness>
            <Thickness x:Key="TabViewHeaderPadding">0,3,0,3</Thickness>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <Thickness x:Key="TabViewItemHeaderPadding">0,0,0,0</Thickness>
            <Thickness x:Key="TabViewHeaderPadding">0,3,0,3</Thickness>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <Thickness x:Key="TabViewItemHeaderPadding">0,0,0,0</Thickness>
            <Thickness x:Key="TabViewHeaderPadding">0,3,0,3</Thickness>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Reusable Borderless TabView Tokens -->
    <Thickness x:Key="TabViewListViewHeaderMargin">0</Thickness>
    <Thickness x:Key="TabViewBorderThickness">0</Thickness>
    <SolidColorBrush x:Key="TabViewBorderBrush"
                     Color="Transparent" />
    <Thickness x:Key="TabViewTabStripBorderThickness">0</Thickness>
    <SolidColorBrush x:Key="TabViewItemStroke"
                     Color="Transparent" />
    <SolidColorBrush x:Key="TabViewItemSeparator"
                     Color="Transparent" />
    <Thickness x:Key="TabViewItemBorderThickness">0</Thickness>
    <Thickness x:Key="TabViewSelectedItemBorderThickness">1</Thickness>
    <Thickness x:Key="TabViewSelectedItemHeaderMargin">0</Thickness>

    <Style TargetType="primitives:TabViewListView">
        <Setter Property="Padding"
                Value="0" />
        <Setter Property="Margin"
                Value="0" />
    </Style>

    <!-- Pill Geometry Overrides -->
    <CornerRadius x:Key="TabViewItemCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
    <x:Double x:Key="TabViewItemHeaderMinHeight">34</x:Double>

    <!-- Pill-Shaped TabViewItem Style -->
    <Style x:Key="PillTabViewItemStyle"
           TargetType="TabViewItem">
        <Setter Property="CornerRadius"
                Value="8" />
        <Setter Property="Margin"
                Value="0 0 3 0" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabViewItem">
                    <Grid x:Name="LayoutRoot">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Target="PillBorder.Background"
                                                Value="Transparent" />
                                        <Setter Target="PillBorder.BorderBrush"
                                                Value="Transparent" />
                                        <Setter Target="ContentPresenter.Foreground"
                                                Value="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Setter Target="IconControl.Foreground"
                                                Value="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Setter Target="CloseButton.Foreground"
                                                Value="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="PillBorder.Background"
                                                Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                        <Setter Target="PillBorder.BorderBrush"
                                                Value="Transparent" />
                                        <Setter Target="ContentPresenter.Foreground"
                                                Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <Setter Target="IconControl.Foreground"
                                                Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <Setter Target="CloseButton.Foreground"
                                                Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="PillBorder.Background"
                                                Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                        <Setter Target="PillBorder.BorderBrush"
                                                Value="Transparent" />
                                        <Setter Target="ContentPresenter.Foreground"
                                                Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <Setter Target="IconControl.Foreground"
                                                Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <Setter Target="CloseButton.Foreground"
                                                Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Target="PillBorder.Background"
                                                Value="Transparent" />
                                        <Setter Target="PillBorder.BorderBrush"
                                                Value="Transparent" />
                                        <Setter Target="ContentPresenter.Foreground"
                                                Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <Setter Target="IconControl.Foreground"
                                                Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <Setter Target="CloseButton.Foreground"
                                                Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOverSelected">
                                    <VisualState.Setters>
                                        <Setter Target="PillBorder.Background"
                                                Value="Transparent" />
                                        <Setter Target="PillBorder.BorderBrush"
                                                Value="Transparent" />
                                        <Setter Target="ContentPresenter.Foreground"
                                                Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <Setter Target="IconControl.Foreground"
                                                Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <Setter Target="CloseButton.Foreground"
                                                Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PressedSelected">
                                    <VisualState.Setters>
                                        <Setter Target="PillBorder.Background"
                                                Value="Transparent" />
                                        <Setter Target="PillBorder.BorderBrush"
                                                Value="Transparent" />
                                        <Setter Target="ContentPresenter.Foreground"
                                                Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <Setter Target="IconControl.Foreground"
                                                Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                        <Setter Target="CloseButton.Foreground"
                                                Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="PillBorder.Background"
                                                Value="Transparent" />
                                        <Setter Target="PillBorder.BorderBrush"
                                                Value="Transparent" />
                                        <Setter Target="ContentPresenter.Foreground"
                                                Value="{ThemeResource TextFillColorDisabledBrush}" />
                                        <Setter Target="IconControl.Foreground"
                                                Value="{ThemeResource TextFillColorDisabledBrush}" />
                                        <Setter Target="CloseButton.Foreground"
                                                Value="{ThemeResource TextFillColorDisabledBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="CloseIconStates">
                                <VisualState x:Name="CloseButtonVisible" />
                                <VisualState x:Name="CloseButtonCollapsed">
                                    <VisualState.Setters>
                                        <Setter Target="CloseButton.Visibility"
                                                Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="IconStates">
                                <VisualState x:Name="Icon" />
                                <VisualState x:Name="NoIcon">
                                    <VisualState.Setters>
                                        <Setter Target="IconBox.Visibility"
                                                Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <!-- Capsule Pill Container: All 4 corners rounded -->
                        <Border x:Name="PillBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,4,10,4"
                                MinHeight="34"
                                VerticalAlignment="Center">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="IconColumn"
                                                      Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition x:Name="CloseColumn"
                                                      Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Viewbox x:Name="IconBox"
                                         Grid.Column="0"
                                         MaxWidth="16"
                                         MaxHeight="16"
                                         VerticalAlignment="Center">
                                    <ContentControl x:Name="IconControl"
                                                    Content="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TabViewTemplateSettings.IconElement}"
                                                    IsTabStop="False"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Viewbox>

                                <ContentPresenter x:Name="ContentPresenter"
                                                  Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Header, Converter={StaticResource StringToVisibilityConverter}}"
                                                  Margin="8,0,0,0"
                                                  Grid.Column="1"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding Header}"
                                                  ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                  FontSize="{ThemeResource TabViewItemHeaderFontSize}"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <Button x:Name="CloseButton"
                                        Margin="6,0,0,0"
                                        Grid.Column="2"
                                        Width="24"
                                        Height="24"
                                        Padding="0"
                                        CornerRadius="12"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Content="&#xE711;"
                                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                        FontSize="10"
                                        IsTabStop="False"
                                        VerticalAlignment="Center">
                                    <Button.Resources>
                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver"
                                                         Color="#20808080" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPressed"
                                                         Color="#30808080" />
                                    </Button.Resources>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
