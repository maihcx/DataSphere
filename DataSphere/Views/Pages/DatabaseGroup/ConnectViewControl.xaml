<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="DataSphere.Views.Pages.DatabaseGroup.ConnectViewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:DataSphere.Models"
    xmlns:vm="using:DataSphere.ViewModels.Pages.DatabaseGroup"
    mc:Ignorable="d">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Command Toolbar -->
        <Border
            Grid.Row="0"
            Padding="16,12"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    Command="{x:Bind ViewModel.NewConnectionCommand}"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE774;" FontSize="16" />
                        <TextBlock Text="{Binding [btn_new_connection], Source={StaticResource Localization}, Mode=OneWay}" />
                    </StackPanel>
                </Button>

                <Button Command="{x:Bind ViewModel.AddFolderCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE838;" FontSize="16" />
                        <TextBlock Text="{Binding [ctx_folder_title], Source={StaticResource Localization}, Mode=OneWay}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Content Area: Connections Tree or Empty State -->
        <Grid Grid.Row="1" Margin="16">
            <!-- Empty State View -->
            <Border
                Visibility="{x:Bind ViewModel.IsEmptyView, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="32"
                MaxWidth="480">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <FontIcon
                        Glyph="&#xE774;"
                        FontSize="48"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        HorizontalAlignment="Center" />

                    <TextBlock
                        Text="{Binding [page_db_conn_list_title], Source={StaticResource Localization}, Mode=OneWay}"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        TextAlignment="Center" />

                    <TextBlock
                        Text="{Binding [page_db_conn_list_desc], Source={StaticResource Localization}, Mode=OneWay}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />

                    <Button
                        Command="{x:Bind ViewModel.NewConnectionCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                            <TextBlock Text="{Binding [btn_new_connection], Source={StaticResource Localization}, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Connections TreeView -->
            <TreeView
                x:Name="ConnectionsTree"
                Visibility="{x:Bind ViewModel.IsNotEmptyView, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                ItemsSource="{x:Bind ViewModel.ConnectItems, Mode=OneWay}"
                ItemInvoked="ConnectionsTree_ItemInvoked"
                SelectionMode="Single"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
                <TreeView.ItemTemplate>
                    <DataTemplate x:DataType="models:ConnectionModel">
                        <TreeViewItem
                            ItemsSource="{x:Bind Children, Mode=OneWay}"
                            DoubleTapped="TreeViewItem_DoubleTapped"
                            ContextRequested="TreeViewItem_ContextRequested">
                            <Grid ColumnSpacing="8" Padding="4,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <FontIcon
                                    Grid.Column="0"
                                    Glyph="{x:Bind IconGlyph, Mode=OneWay}"
                                    FontSize="16"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    VerticalAlignment="Center" />

                                <!-- Display Text -->
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{x:Bind Name, Mode=OneWay}"
                                    Visibility="{x:Bind IsEditing, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                    VerticalAlignment="Center" />

                                <!-- Inline Editing Text -->
                                <TextBox
                                    Grid.Column="1"
                                    Text="{x:Bind Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Visibility="{x:Bind IsEditing, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    KeyDown="RenameTextBox_KeyDown"
                                    LostFocus="RenameTextBox_LostFocus"
                                    MinWidth="120"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </TreeViewItem>
                    </DataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Grid>
    </Grid>
</UserControl>
