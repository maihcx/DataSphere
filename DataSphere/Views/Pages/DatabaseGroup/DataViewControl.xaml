<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="DataSphere.Views.Pages.DatabaseGroup.DataViewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:dbmodels="using:DataSphere.Models.Database"
    xmlns:models="using:DataSphere.Models"
    xmlns:vm="using:DataSphere.ViewModels.Pages.DatabaseGroup"
    xmlns:vt="using:DataSphere.Controls.VirtualTable"
    mc:Ignorable="d">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Viewport Toolbar -->
        <Border
            Grid.Row="0"
            Padding="16,10"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xF0E2;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <ProgressRing
                        Width="16" Height="16"
                        IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.EditingNoticeText, Mode=OneWay}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <!-- Commit Changes Button -->
                    <Button
                        Command="{x:Bind ViewModel.CommitChangesCommand}"
                        IsEnabled="{x:Bind ViewModel.CanCommit, Mode=OneWay}"
                        ToolTipService.ToolTip="{Binding [tooltip_commit_changes], Source={StaticResource Localization}, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74E;" FontSize="14" />
                            <TextBlock Text="{Binding [btn_commit_changes], Source={StaticResource Localization}, Mode=OneWay}" />
                        </StackPanel>
                    </Button>

                    <!-- Discard Changes Button -->
                    <Button
                        Command="{x:Bind ViewModel.DiscardChangesCommand}"
                        IsEnabled="{x:Bind ViewModel.CanDiscard, Mode=OneWay}"
                        ToolTipService.ToolTip="{Binding [tooltip_discard_changes], Source={StaticResource Localization}, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE711;" FontSize="14" />
                            <TextBlock Text="{Binding [btn_discard_changes], Source={StaticResource Localization}, Mode=OneWay}" />
                        </StackPanel>
                    </Button>

                    <!-- Refresh Button -->
                    <Button Command="{x:Bind ViewModel.RefreshCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="{Binding [btn_refresh_table], Source={StaticResource Localization}, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Table Records Viewport via High-Performance VirtualTable Control -->
        <Border Grid.Row="1" Background="Transparent">
            <vt:VirtualTable
                RowHeight="34"
                DataProvider="{x:Bind ViewModel.TableDataProvider, Mode=OneWay}"
                SortCommand="{x:Bind ViewModel.SortCommand, Mode=OneWay}"
                CellEditedCommand="{x:Bind ViewModel.CellEditedCommand, Mode=OneWay}" />
        </Border>

        <!-- Pagination Footer -->
        <Border
            Grid.Row="2"
            Padding="16,10"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Page Size Selector -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock
                        Text="{Binding [pagination_rows_per_page], Source={StaticResource Localization}, Mode=OneWay}"
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                    <ComboBox
                        ItemsSource="{x:Bind ViewModel.PageSizes, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.PageSize, Mode=TwoWay}"
                        MinWidth="90" />
                </StackPanel>

                <!-- Summary Info -->
                <TextBlock
                    Grid.Column="1"
                    Text="{x:Bind ViewModel.PageSummaryText, Mode=OneWay}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}" />

                <!-- Navigation Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button
                        Command="{x:Bind ViewModel.PreviousPageCommand}"
                        IsEnabled="{x:Bind ViewModel.CanGoPrevious, Mode=OneWay}">
                        <FontIcon Glyph="&#xE76B;" FontSize="12" />
                    </Button>
                    <Button
                        Command="{x:Bind ViewModel.NextPageCommand}"
                        IsEnabled="{x:Bind ViewModel.CanGoNext, Mode=OneWay}">
                        <FontIcon Glyph="&#xE76C;" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
