<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="DataSphere.Views.Pages.DatabaseGroup.DataViewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:dbmodels="using:DataSphere.Models.Database"
    xmlns:models="using:DataSphere.Models"
    xmlns:vm="using:DataSphere.ViewModels.Pages.DatabaseGroup"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Viewport Toolbar -->
        <Border
            Grid.Row="0"
            Padding="16,10"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xF0E2;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <ProgressRing
                        Width="16" Height="16"
                        IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.RefreshCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="{Binding [btn_refresh_table], Source={StaticResource Localization}, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Two-Tier Viewport-Pinned Records Grid Viewport -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Sticky Column Headers Row (Synchronized Horizontal Offset) -->
            <ScrollViewer
                x:Name="HeaderScrollViewer"
                Grid.Row="0"
                HorizontalScrollBarVisibility="Hidden"
                HorizontalScrollMode="Enabled"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled">
                <Border
                    MinWidth="{x:Bind ViewModel.DataPage.TotalTableWidth, Mode=OneWay}"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="8,8,24,8">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.DataPage.Columns, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="dbmodels:Column">
                                <Border
                                    Width="140"
                                    Padding="8,4"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind DataType}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </ScrollViewer>

            <!-- Virtualized Data Rows List (Pinned to Viewport Boundaries) -->
            <ListView
                x:Name="DataRowsListView"
                Grid.Row="1"
                ItemsSource="{x:Bind ViewModel.DataPage.Rows, Mode=OneWay}"
                SelectionMode="Single"
                Padding="0"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollMode="Enabled"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.HorizontalScrollMode="Enabled">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel Orientation="Vertical" CacheLength="2.0" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:TableRowData">
                        <Border Padding="8,0">
                            <ItemsControl ItemsSource="{x:Bind Cells}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border Width="140" Padding="8,6" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                            <TextBlock
                                                Text="{x:Bind}"
                                                TextTrimming="CharacterEllipsis"
                                                IsTextSelectionEnabled="True" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Pagination Footer -->
        <Border
            Grid.Row="2"
            Padding="16,10"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Page Size Selector -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock
                        Text="{Binding [pagination_rows_per_page], Source={StaticResource Localization}, Mode=OneWay}"
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                    <ComboBox
                        ItemsSource="{x:Bind ViewModel.PageSizes, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.PageSize, Mode=TwoWay}"
                        MinWidth="90" />
                </StackPanel>

                <!-- Summary Info -->
                <TextBlock
                    Grid.Column="1"
                    Text="{x:Bind ViewModel.PageSummaryText, Mode=OneWay}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}" />

                <!-- Navigation Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button
                        Command="{x:Bind ViewModel.PreviousPageCommand}"
                        IsEnabled="{x:Bind ViewModel.CanGoPrevious, Mode=OneWay}">
                        <FontIcon Glyph="&#xE76B;" FontSize="12" />
                    </Button>
                    <Button
                        Command="{x:Bind ViewModel.NextPageCommand}"
                        IsEnabled="{x:Bind ViewModel.CanGoNext, Mode=OneWay}">
                        <FontIcon Glyph="&#xE76C;" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
