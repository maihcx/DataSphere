<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DataSphere.Views.PagesBottom.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:vm="using:DataSphere.ViewModels.PagesBottom"
      Background="Transparent"
      mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  MaxWidth="900"
                  Background="Transparent">
        <StackPanel Spacing="14"
                    Padding="24,24,24,32"
                    HorizontalAlignment="Stretch"
                    Background="Transparent">

            <!-- Section: Personalization -->
            <TextBlock Text="{Binding [page_settings_personalization_title], Source={StaticResource Localization}, Mode=OneWay}"
                       Style="{StaticResource SubtitleTextBlockStyle}" />

            <!-- App Theme Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0"
                              Glyph="&#xE790;"
                              FontSize="20"
                              Margin="0,0,16,0"
                              VerticalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                        <TextBlock Text="{Binding [page_settings_app_theme_title], Source={StaticResource Localization}, Mode=OneWay}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{Binding [page_settings_app_theme_summary], Source={StaticResource Localization}, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <ComboBox Grid.Column="2"
                              MinWidth="200"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              ItemsSource="{x:Bind ViewModel.ThemeList, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName" />
                </Grid>
            </Border>

            <!-- System Backdrop Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0"
                              Glyph="&#xE771;"
                              FontSize="20"
                              Margin="0,0,16,0"
                              VerticalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                        <TextBlock Text="{Binding [page_settings_backdrop_title], Source={StaticResource Localization}, Mode=OneWay}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{Binding [page_settings_backdrop_summary], Source={StaticResource Localization}, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <ComboBox Grid.Column="2"
                              MinWidth="200"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              ItemsSource="{x:Bind ViewModel.BackdropList, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedBackdrop, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName" />
                </Grid>
            </Border>

            <!-- Language Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0"
                              Glyph="&#xE775;"
                              FontSize="20"
                              Margin="0,0,16,0"
                              VerticalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorPrimaryBrush}" />

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                        <TextBlock Text="{Binding [page_settings_languageset_title], Source={StaticResource Localization}, Mode=OneWay}"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{Binding [page_settings_languageset_display_summary], Source={StaticResource Localization}, Mode=OneWay}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <ComboBox Grid.Column="2"
                              MinWidth="200"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              ItemsSource="{x:Bind ViewModel.Languages, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}"
                              DisplayMemberPath="NativeName" />
                </Grid>
            </Border>

            <!-- Section: About -->
                <TextBlock Text="{Binding [page_settings_about_title], Source={StaticResource Localization}, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />

                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <FontIcon Glyph="&#xE946;" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind ViewModel.AppVersion, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.CopyRight, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
